# ========================================================
# 대한안전포털 Supabase 연동 환경 변수
# Supabase 대시보드 (https://app.supabase.com) > Project Settings > API 에서 복사
# ========================================================

# Supabase 프로젝트 URL (예: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase API Key (anon public key 또는 service_role secret key)
SUPABASE_KEY=

# 웹 서버 포트
PORT=3000

# ========================================================
# 대한민국 정부 공공데이터포털(data.go.kr) API 연동 키
# 발급: https://www.data.go.kr 마이페이지 > 오픈API > 개발계정
# ========================================================
# 공공데이터포털 일반 인증키 (Encoding 또는 Decoding 키)
DATA_GO_KR_API_KEY=

# (선택) 고용노동부 중대재해 속보 전용 API 키 (미설정 시 DATA_GO_KR_API_KEY 공용 사용)
MOEL_API_KEY=

# (선택) 한국산업안전보건공단(KOSHA) 안전가이드 전용 API 키
KOSHA_API_KEY=

# (선택) 소방청(소방방재청) 전국 화재현황 전용 API 키
NFA_FIRE_API_KEY=

# ========================================================
# 시스템 보안 및 관리자 인증 설정
# ========================================================
# 최고관리자 마스터 인증 비밀번호 (현장 모바일 승인 및 긴급 관리자 접속용)
ADMIN_MASTER_PASSWORD=

# 초기 인메모리 테스트 관리자/회원 기본 비밀번호
ADMIN_INITIAL_PASSWORD=
MEMBER_INITIAL_PASSWORD=
